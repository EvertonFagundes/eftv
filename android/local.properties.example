# Copie para local.properties e preencha os valores locais.
# local.properties NAO vai para o Git.
sdk.dir=/home/SEU_USUARIO/Android/Sdk

# Playlist licenciada (fica fora do repositorio e do APK comercial)
EFTV_PLAYLIST_URL=
EFTV_PLAYLIST_USER_AGENT=VLC/3.0.20 LibVLC/3.0.20

# Backend central usado pelo login e pela entrega da playlist
EFTV_API_URL=http://127.0.0.1:8000
