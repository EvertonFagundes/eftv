<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Atualizacao do APK dentro do app (fora da loja) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Transmitir tela: descobrir a TV na rede e manter a captura viva -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!-- Android TV -->
    <uses-feature android:name="android.hardware.type.television" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <!-- Captura de som da reproducao: TV box sem microfone continua compativel -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!--
      Android 11+ esconde outros apps por padrao. Sem estas consultas o botao
      "Abrir com outro player" nao encontra o VLC/mpv para formatos que o
      player interno nao decodifica (AVI, WMV, HEVC sem suporte etc.).
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="video/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/x-mpegURL" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/vnd.apple.mpegurl" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/x-rtsp" />
        </intent>
    </queries>

    <application
        android:name=".EftvApplication"
        android:allowBackup="true"
        android:banner="@drawable/tv_banner"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.EFTV"
        tools:targetApi="31">

        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:theme="@style/Theme.EFTV.NoActionBar"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Android TV -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>

            <!-- Deep link de verificacao de email (ex: eftv://verify-email?token=...) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="eftv" android:host="verify-email" />
            </intent-filter>

            <!-- Volta do checkout do Mercado Pago para o app (eftv://open) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="eftv" android:host="open" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SubscriptionActivity"
            android:exported="false"
            android:theme="@style/Theme.EFTV.NoActionBar" />

        <activity
            android:name=".EmailVerificationActivity"
            android:exported="false"
            android:theme="@style/Theme.EFTV.NoActionBar"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize" />

        <activity
            android:name=".CategoriesActivity"
            android:exported="false"
            android:theme="@style/Theme.EFTV.NoActionBar"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize" />

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|uiMode"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@style/Theme.EFTV.NoActionBar"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize" />

        <activity
            android:name=".PlayerActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize"
            android:exported="false"
            android:theme="@style/Theme.EFTV.Player" />

        <!-- Configuracoes escondidas (acessivel por toque longo no titulo da tela principal) -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.EFTV.NoActionBar" />

        <activity
            android:name=".SeriesActivity"
            android:exported="false"
            android:theme="@style/Theme.EFTV.NoActionBar" />

        <!-- Transmitir a tela do celular para a TV (rede local) -->
        <activity
            android:name=".CastSendActivity"
            android:exported="false"
            android:theme="@style/Theme.EFTV.NoActionBar" />

        <activity
            android:name=".CastReceiveActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize"
            android:exported="false"
            android:theme="@style/Theme.EFTV.Player" />

        <service
            android:name=".cast.CastService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection"
            android:stopWithTask="false" />

        <service
            android:name=".EftvServerService"
            android:exported="false"
            android:stopWithTask="false" />

        <!-- Compartilha o APK baixado com o instalador do Android. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
