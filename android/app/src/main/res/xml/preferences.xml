<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        android:key="category_tv"
        android:title="@string/settings_category_tv"
        app:iconSpaceReserved="false">

        <ListPreference
            android:defaultValue="24"
            android:entries="@array/tv_overscan_entries"
            android:entryValues="@array/tv_overscan_values"
            android:key="pref_tv_overscan"
            android:summary="%s"
            android:title="@string/settings_overscan_title"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="category_privacy"
        android:title="@string/settings_category_privacy"
        app:iconSpaceReserved="false">

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="pref_show_adult"
            android:summary="@string/settings_adult_summary"
            android:title="@string/settings_adult_title"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="category_account"
        android:title="@string/settings_category_account"
        app:iconSpaceReserved="false">

        <Preference
            android:key="pref_delete_account"
            android:summary="@string/settings_delete_account_summary"
            android:title="@string/settings_delete_account"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="category_about"
        android:title="@string/settings_category_about"
        app:iconSpaceReserved="false">

        <Preference
            android:key="pref_terms"
            android:title="@string/settings_terms"
            app:iconSpaceReserved="false" />

        <Preference
            android:key="pref_privacy"
            android:title="@string/settings_privacy"
            app:iconSpaceReserved="false" />

        <Preference
            android:key="pref_version"
            android:title="@string/settings_about_version"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

</PreferenceScreen>
