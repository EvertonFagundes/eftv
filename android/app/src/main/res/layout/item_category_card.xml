<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/categoryCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/cat_all_container"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:contentPadding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Icone real (Material Symbols) dentro do selo redondo. Se o grupo nao
             tiver um icone conhecido, o selo mostra a inicial do nome. -->
        <FrameLayout
            android:id="@+id/categoryBadge"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_category_badge">

            <ImageView
                android:id="@+id/categoryIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                tools:src="@drawable/ic_tv" />

            <TextView
                android:id="@+id/categoryInitial"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="A"
                tools:visibility="visible" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/categoryLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                android:textColor="@color/cat_text"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="Jogos do Dia" />

            <TextView
                android:id="@+id/categoryCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="@color/cat_text"
                tools:text="128 canais" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
