<?xml version="1.0" encoding="utf-8"?>
<!-- Cartão de destaque da assinatura: gradiente azul profundo. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="20dp" />
    <gradient
        android:angle="315"
        android:startColor="#123A6B"
        android:centerColor="#0E2A4E"
        android:endColor="@color/surface_container_low"
        android:type="linear" />
    <stroke
        android:width="1dp"
        android:color="#2A5C99" />
</shape>
