# Copie para deploy/.env e preencha. NAO versionar.
# Usado por docker-compose.prod.yml (substituicao de variaveis).

# Dominio publico da API (DNS deve apontar para a VPS)
DOMAIN=api.eftv.com.br

# Banco de dados (senha forte, sem espacos)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-por-uma-senha-longa-e-aleatoria
POSTGRES_DB=eftv
