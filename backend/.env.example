# .env.example - Copie para .env e preencha os valores

# App
APP_NAME=EFTV API
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8000

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/eftv
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Security (GERE UMA CHAVE FORTE: openssl rand -hex 32)
SECRET_KEY=sua-chave-secreta-super-forte-aqui-minimo-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
BCRYPT_ROUNDS=12

# CORS (origins permitidas para frontend)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","https://app.eftv.com.br"]

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Redis (opcional - para rate limiting, cache, sessões em produção)
REDIS_URL=redis://localhost:6379/0

# Mercado Pago (obtenha em https://www.mercadopago.com.br/developers/panel)
MERCADOPAGO_ACCESS_TOKEN=APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MERCADOPAGO_PUBLIC_KEY=APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MERCADOPAGO_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MERCADOPAGO_SANDBOX=true

# Streaming - Cloudflare Stream (obtenha em https://dash.cloudflare.com/)
STREAM_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLOUDFLARE_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STREAM_TOKEN_TTL_SECONDS=900
STREAM_TOKEN_ISSUER=eftv-api

# Playlist IPTV do provedor licenciado (entregue apenas a assinantes ativos)
# NUNCA coloque essa URL no APK: ela fica no servidor e pode ser trocada/revogada.
IPTV_PLAYLIST_URL=
IPTV_PLAYLIST_USER_AGENT=VLC/3.0.20 LibVLC/3.0.20
IPTV_PLAYLIST_REFERER=
# Revalidacao do acesso pelo app (segundos)
IPTV_PLAYLIST_REFRESH_SECONDS=300
# Tolerancia offline usando o catalogo salvo (minutos)
OFFLINE_GRACE_MINUTES=720

# Email - Resend (obtenha em https://resend.com/)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=EFTV <noreply@eftv.com.br>

# Frontend URL (para links em emails, redirects)
FRONTEND_URL=http://localhost:3000

# Logging
LOG_LEVEL=INFO

# Sentry (opcional - para error tracking)
SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@o0.ingest.sentry.io/0